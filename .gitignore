# ── 설치하면 다시 생기는 것 ─────────────────────────────
node_modules/

# ── 빌드 중간물·보고서 ──────────────────────────────────
.build/
reports/
dist/

# packs/ 는 git 기록에 넣지 않습니다. 릴리스 파일(module.zip)에만 들어갑니다.
# (git 기록은 지울 수 없어 계속 쌓이지만, 릴리스는 지우면 용량이 바로 사라집니다)
packs/*
!packs/.gitkeep

# ── 번역 원본·작업 도구 (로컬 전용, 따로 백업하세요) ────
compendium/
deepl-tool/

# ── 이 PC에서만 쓰는 설정 ───────────────────────────────
tools/local.config.json
.env
*.env

# 스튜디오 자동 백업
.studio-backup/

# ── 기타 ────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
